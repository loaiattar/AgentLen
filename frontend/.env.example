# Browser-facing API prefix (docs/architecture/API.md).
# Relative URL: Vite proxies `/api` to the backend during `npm run dev`.
VITE_API_BASE_URL=/api/v1

# Must match the backend `API_KEY`. Read by the Vite dev proxy only, which adds
# it to every `/api` call as the `X-API-Key` header. Without the VITE_ prefix it
# never reaches the browser — never rename it VITE_API_KEY: Vite would inline
# it into the JavaScript bundle.
API_KEY=change-me-in-production

# Backend origin for the Vite proxy only (not exposed to the browser).
# API_PROXY_TARGET=http://127.0.0.1:8000
