# Browser-facing API prefix (docs/architecture/API.md).
# Relative URL: Vite proxies `/api` to the backend during `npm run dev`.
VITE_API_BASE_URL=/api/v1

# Must match the backend `API_KEY` (repo `.env` for Docker). Sent as `X-API-Key`.
VITE_API_KEY=change-me

# Backend origin for the Vite proxy only (not exposed to the browser).
# API_PROXY_TARGET=http://127.0.0.1:8000
