# Copy to .env before `docker compose up` (docker/docker-compose.yml). No
# value below is a real secret — see docs/architecture/ARCHITECTURE.md §12.

DATABASE_URL=postgresql+asyncpg://agentlen:agentlen@db:5432/agentlen
# Checked by `api`; also given to `frontend`, whose nginx adds it to every
# `/api` call. It is never sent to the browser.
API_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:5173
AI_PROVIDER=fake
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=8000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MAX_UPLOAD_SIZE_MB=512
PROFILE_SAMPLE_SIZE=500
IMPORT_BATCH_SIZE=500
IMPORT_LOCK_TIMEOUT_MINUTES=15
IMPORT_MAX_ATTEMPTS=3
# Bounds on the AI agent. `AISettings` carries env_prefix="AI_", so the
# unprefixed MAX_CONVERSATION_TURNS that used to sit here was never read.
# AI_MAX_ITERATIONS bounds the initial analysis loop, AI_MAX_REFINEMENT_ITERATIONS
# the tool loop of one refinement, AI_MAX_CONVERSATION_TURNS how many stored
# turns are replayed into a refinement prompt.
AI_MAX_ITERATIONS=10
AI_MAX_REFINEMENT_ITERATIONS=10
AI_MAX_CONVERSATION_TURNS=10
# Host port of the web interface started by `make up`. The interface calls the
# API through its own origin, so ALLOWED_ORIGINS above only matters for
# `npm run dev` (http://localhost:5173).
# FRONTEND_HOST_PORT=8080
